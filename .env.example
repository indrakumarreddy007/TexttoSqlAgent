# Copy to .env. All settings: sqlagent/config.py (prefix SQLAGENT_).
SQLAGENT_LLM_PROVIDER=ollama              # ollama | anthropic | openai (any OpenAI-compatible, e.g. Groq)
SQLAGENT_LLM_MODEL=qwen2.5-coder:7b
# SQLAGENT_LLM_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=...                   # if provider=anthropic (pip install .[anthropic])
# OPENAI_API_KEY=...                      # if provider=openai (pip install langchain-openai)
SQLAGENT_MAX_SQL_ATTEMPTS=3
SQLAGENT_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
