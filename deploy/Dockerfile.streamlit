# Simple UI image (Streamlit + agent in one process). Works on Hugging Face Spaces, Azure Container
# Apps, Render, Fly.io or any Docker host. Build from the repo root:
#   docker build -f deploy/Dockerfile.streamlit -t halcyon-sql-ui .
#   docker run -p 8501:8501 -e SQLAGENT_LLM_PROVIDER=openai -e SQLAGENT_LLM_BASE_URL=... -e OPENAI_API_KEY=... halcyon-sql-ui
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SQLAGENT_HOME=/app PORT=8501
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[ui,openai,anthropic]"

COPY config ./config
COPY apps ./apps

# uid 1000 is what Hugging Face Spaces runs as. The warehouse is built into /app/data on first start.
RUN useradd --create-home --uid 1000 app && mkdir -p /app/data && chown -R app /app
USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import os,urllib.request;urllib.request.urlopen(f'http://localhost:{os.environ.get(\"PORT\",\"8501\")}/_stcore/health')"
CMD ["sh", "-c", "streamlit run apps/streamlit_app.py --server.port ${PORT} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
